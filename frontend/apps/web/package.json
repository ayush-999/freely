{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:crypto": "node tests/crypto/browser-tests.mjs",
    "test:chat-ui": "node tests/chat-ui/browser-tests.mjs",
    "test:profile-ui": "node tests/profile-ui/browser-tests.mjs"
  },
  "dependencies": {
    "@getmaapp/signal-wasm": "0.6.6",
    "@reduxjs/toolkit": "^2.13.0",
    "@workspace/auth": "*",
    "@workspace/constants": "*",
    "@workspace/ui": "*",
    "@workspace/utils": "*",
    "axios": "^1.20.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "jsdom": "30.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "5.1.0"
  }
}
