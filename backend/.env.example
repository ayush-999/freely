# ============================================================
# Freely backend — environment configuration
# Copy this file to `.env` and adjust values for your machine.
# NEVER commit real secrets to version control.
# ============================================================

# --- Application ---
APP_NAME=Freely API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# --- Security ---
# Generate a long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (Microsoft SQL Server) ---
# Windows Authentication: leave DB_USER and DB_PASSWORD empty.
# SQL Server login: set DB_USER/DB_PASSWORD (e.g. sa).
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=freely
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Object storage (files live outside the DB; DB stores storage keys) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage

# --- External AI assessment service ---
AI_SERVICE_URL=http://localhost:9000
AI_SERVICE_TIMEOUT_SECONDS=30

# --- Notification providers ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_URL=
PUSH_PROVIDER_URL=
